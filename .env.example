# MongoDB Atlas connection string. For offline work run `pnpm db:local` and use mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=hangup
# Google AI Studio key funded by the DeepMind credits. Server-side only.
GEMINI_API_KEY=
# Minutes before an unacknowledged alert counts as escalated.
ESCALATE_AFTER_MIN=3
# Private operator-held codes, each at least 16 random characters. Never NEXT_PUBLIC_.
ELDER_DEMO_ACCESS_CODE=
CALL_DEMO_ACCESS_CODE=
# The fixed sample has not been captured; 1 intentionally refuses to start calls.
DEMO_FALLBACK=0
