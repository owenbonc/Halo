# MongoDB Atlas connection string. For offline work run `pnpm db:local` and use mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=hangup
# Google AI Studio key funded by the DeepMind credits. Server-side only.
GEMINI_API_KEY=
# Minutes before an unacknowledged alert counts as escalated.
ESCALATE_AFTER_MIN=3
# 1 serves recorded analysis responses when the venue wifi fails.
DEMO_FALLBACK=0
